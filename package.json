{
  "name": "deretsolver",
  "private": true,
  "version": "1.5.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "cross-env VITE_COVERAGE=true playwright test",
    "coverage:e2e": "npm run test:e2e:coverage && nyc report --reporter=text --reporter=html",
    "build": "vite build",
    "lint": "oxlint . --ignore-path .gitignore --ignore-pattern functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/material-symbols-outlined": "^5.2.34",
    "@google/genai": "^1.39.0",
    "firebase": "^12.7.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "isomorphic-dompurify": "^2.35.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.5.1",
    "react-router-dom": "^7.13.0",
    "zod": "^4.3.4",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "jsdom": "^27.3.0",
    "nyc": "^17.1.0",
    "oxlint": "^1.36.0",
    "playwright": "^1.58.1",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1",
    "vitest": "^4.0.16"
  }
